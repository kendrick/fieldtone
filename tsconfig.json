{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		// Next writes these itself, but only into a tsconfig with no `extends`.
		// This one extends the base, so Next bails out and they live here by hand.
		// `preserve` hands JSX to the Next compiler rather than tsc.
		"jsx": "preserve",
		"paths": {
			"@/*": ["./src/*"]
		},
		// For public/worklets/*.js below. `checkJs` stays off: a worklet is plain JS
		// because no bundler ever sees it, and checking it would mean carrying JSDoc
		// annotations for types that exist nowhere else in the repo.
		"allowJs": true,
		"plugins": [{ "name": "next" }]
	},
	"include": [
		"next-env.d.ts",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"tests/**/*.ts",
		"tests/**/*.tsx",
		// Served as a static asset, never bundled, but a spec imports it and TS
		// cannot resolve a file it was never told about.
		"public/worklets/*.js",
		"*.config.ts",
		"*.config.mjs"
	],
	// `.next` is deliberately absent below: exclude outranks include, and the
	// generated route types above live in there.
	"exclude": ["node_modules", "dist", "build", "out"]
}
